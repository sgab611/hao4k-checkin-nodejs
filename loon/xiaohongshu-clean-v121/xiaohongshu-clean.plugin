#!name=小红书净化
#!desc=移除开屏广告、信息流广告、搜索推荐广告，并提供隐藏视频贴文开关
#!author=Codex
#!version=1.2.1
#!homepage=https://github.com/sgab611/hao4k-checkin-nodejs/tree/main/loon/xiaohongshu-clean-v120
#!system=iOS
#!loon_version=3.2.1(733)
#!tag=小红书,去广告

[Argument]
hide_video = switch,false,tag=隐藏视频贴文,desc=开启后过滤首页与搜索流中的视频贴文

[Rule]
# 强制小红书相关域名不要走 QUIC，尽量回落到 HTTPS，便于脚本拦截响应体
AND,((PROTOCOL,QUIC),(OR,((DOMAIN-SUFFIX,xiaohongshu.com),(DOMAIN-SUFFIX,xhscdn.com)))),REJECT-DROP

[Rewrite]
# 直接拦截已知广告、推荐和无关请求
^https?:\/\/[a-z0-9-]+\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/notes\/recommend_info\? url reject-200
^https?:\/\/[a-z0-9-]+\.xiaohongshu\.com\/api\/sns\/v\d+\/system_service\/splash url reject-200
^https?:\/\/[a-z0-9-]+\.xiaohongshu\.com\/api\/gslb url reject-200
^https?:\/\/[a-z0-9-]+\.xiaohongshu\.com\/api\/sns\/v\d+\/(tag\/)?ads url reject-200
^https?:\/\/[a-z0-9-]+\.xiaohongshu\.com\/v\d+\/stateReport url reject-200
^https?:\/\/[a-z0-9-]+\.xiaohongshu\.com\/data\/native\/matrix_switches url reject-200
^https?:\/\/[a-z0-9-]+\.xiaohongshu\.com\/api\/sns\/v\d+\/user\/teenager\/status url reject-200
^https?:\/\/[a-z0-9-]+\.xiaohongshu\.com\/api\/sns\/v\d+\/guide\/home_guide url reject-200

[Script]
# 隐藏视频开启时，优先使用包含去广告+去视频的脚本
http-response ^https?:\/\/(?:[\w-]+\.)*xiaohongshu\.com\/api\/sns\/v\d+\/(?:homefeed(?:\/categories)?|note\/feed|note\/imagefeed|note\/videofeed|note\/tabfeed|note\/widgets|note\/redtube|search\/notes|search\/hot_list|search\/hint|search\/trending|system_service\/config|system_service\/splash_config).* script-path = https://cdn.jsdelivr.net/gh/sgab611/hao4k-checkin-nodejs@main/loon/xiaohongshu-clean-v120/xhs-hide-video.js, requires-body = true, timeout = 60, tag = 小红书隐藏视频, enable={hide_video}

# 常规去广告脚本
http-response ^https?:\/\/(?:[\w-]+\.)*xiaohongshu\.com\/api\/sns\/v\d+\/(?:homefeed(?:\/categories)?|note\/feed|note\/imagefeed|note\/videofeed|note\/tabfeed|note\/widgets|note\/redtube|search\/notes|search\/hot_list|search\/hint|search\/trending|system_service\/config|system_service\/splash_config).* script-path = https://cdn.jsdelivr.net/gh/sgab611/hao4k-checkin-nodejs@main/loon/xiaohongshu-clean-v120/xhs-ad-only.js, requires-body = true, timeout = 60, tag = 小红书净化

[MITM]
hostname = *.xiaohongshu.com, xiaohongshu.com, *.xhscdn.com, xhscdn.com
